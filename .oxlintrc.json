{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "eslint/no-console": ["error", { "allow": ["warn", "error", "info"] }]
  },
  "ignorePatterns": [".nuxt", ".output", "node_modules", "dist", "jazz", "pinia"]
}
