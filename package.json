{
  "name": "nuxt-sync-engine",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Build your own sync engine with Nuxt 4 and SQLite - a local-first todo app",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "setup:wasm": "mkdir -p public/wasm && cp node_modules/sql.js/dist/sql-wasm.wasm public/wasm/",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:server": "vitest run tests/server",
    "test:native": "vitest run tests/server/database.test.ts",
    "test:nuxt": "vitest run --config vitest.nuxt.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "nuxt": "^4.0.0",
    "sql.js": "^1.12.0",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@nuxt/test-utils": "^3.23.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.12",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-oxlint": "^1.42.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "happy-dom": "^20.4.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.42.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs}": [
      "oxlint --fix",
      "eslint --fix"
    ]
  }
}
